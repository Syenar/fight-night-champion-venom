+bool D3D12RenderTargetCache::WantsGameplayPair801() const {
+  if (!REXCVAR_GET(venom_sbs_gameplay_pair_probe) ||
+      GetPath() != Path::kHostRenderTargets) {
+    return false;
+  }
+  std::lock_guard<std::mutex> lock(g_venom_sbs_gameplay_pair_mutex);
+  const auto it = g_venom_sbs_gameplay_pairs.find(
+      const_cast<D3D12RenderTargetCache*>(this));
+  return it == g_venom_sbs_gameplay_pairs.end() || !it->second ||
+         !it->second->attempted;
+}
+
+HRESULT D3D12RenderTargetCache::RecordGameplayPair801(
+    const BoundHostTargetsSnapshot778& snapshot, const D3D12_VIEWPORT& viewport,
+    const D3D12_RECT& scissor, UINT system_root_index,
+    D3D12_GPU_VIRTUAL_ADDRESS original_cbv,
+    D3D12_GPU_VIRTUAL_ADDRESS left_cbv,
+    D3D12_GPU_VIRTUAL_ADDRESS right_cbv, UINT draw_count, bool indexed,
+    FLOAT depth_clear, bool& original_drawn, bool qualified, bool stencil_disabled) {
+  if (!REXCVAR_GET(venom_sbs_gameplay_pair_probe) ||
+      GetPath() != Path::kHostRenderTargets || !qualified || !stencil_disabled) {
+    return E_INVALIDARG;
+  }
+
+  std::lock_guard<std::mutex> lock(g_venom_sbs_gameplay_pair_mutex);
+  auto it = g_venom_sbs_gameplay_pairs.find(this);
+  if (it == g_venom_sbs_gameplay_pairs.end() || !it->second) {
+    try {
+      auto context = std::make_unique<GameplayPairContext801>();
+      auto insertion = g_venom_sbs_gameplay_pairs.emplace(this, std::move(context));
+      if (!insertion.second || !insertion.first->second) return E_FAIL;
+      it = insertion.first;
+    } catch (const std::bad_alloc&) {
+      return E_OUTOFMEMORY;
+    }
+  }
+  GameplayPairContext801& context = *it->second;
+  if (context.attempted || context.attempts >= GameplayPairContext801::kMaxAttempts) {
+    return E_INVALIDARG;
+  }
+  context.attempted = true;
+  ++context.attempts;
+  ID3D12Device* const device = command_processor_.GetD3D12Provider().GetDevice();
+  REXGPU_INFO("VENOM_SBS892_INPUT has_depth={} rtv_count={} dsv_format={} rtv_formats={},{},{},{}",
+              snapshot.has_depth, snapshot.rtv_count,
+              uint32_t(snapshot.dsv_format), uint32_t(snapshot.rtv_formats[0]),
+              uint32_t(snapshot.rtv_formats[1]), uint32_t(snapshot.rtv_formats[2]),
+              uint32_t(snapshot.rtv_formats[3]));
+  for (uint32_t resource_index = 0; resource_index < snapshot.resource_descs.size();
+       ++resource_index) {
+    const D3D12_RESOURCE_DESC& desc = snapshot.resource_descs[resource_index];
+    REXGPU_INFO("VENOM_SBS892_RESOURCE index={} dimension={} alignment={} width={} height={} array_size={} mip_levels={} format={} sample_count={} sample_quality={} layout={} flags={}",
+                resource_index, uint32_t(desc.Dimension), uint64_t(desc.Alignment),
+                uint64_t(desc.Width), uint32_t(desc.Height),
+                uint32_t(desc.DepthOrArraySize), uint32_t(desc.MipLevels),
+                uint32_t(desc.Format), uint32_t(desc.SampleDesc.Count),
+                uint32_t(desc.SampleDesc.Quality), uint32_t(desc.Layout),
+                uint32_t(desc.Flags));
+  }
+  REXGPU_INFO("VENOM_SBS892_DRAW original_cbv={} left_cbv={} right_cbv={} system_root_index={} viewport={},{},{},{},{}..{} scissor={},{},{},{} depth_clear={} qualified={} stencil_disabled={} submission={}",
+              uint64_t(original_cbv), uint64_t(left_cbv), uint64_t(right_cbv),
+              system_root_index, viewport.TopLeftX, viewport.TopLeftY,
+              viewport.Width, viewport.Height, viewport.MinDepth, viewport.MaxDepth,
+              scissor.left, scissor.top, scissor.right, scissor.bottom,
+              depth_clear, qualified, stencil_disabled,
+              command_processor_.GetCurrentSubmission());
+  context.result = context.owner->Initialize(device, snapshot);
+  REXGPU_INFO("VENOM_SBS892_INITIALIZE HRESULT=0x{:08X} submission={}",
+              uint32_t(context.result), command_processor_.GetCurrentSubmission());
+  const uint64_t submission = command_processor_.GetCurrentSubmission();
+  if (SUCCEEDED(context.result)) {
+    context.owner->TraceOriginalDraw(command_processor_.GetDeferredCommandList(), draw_count, indexed);
+    original_drawn = true;
+    context.result = context.owner->Record(
+        command_processor_.GetDeferredCommandList(), snapshot, viewport, scissor,
+        system_root_index, original_cbv, left_cbv, right_cbv, draw_count, indexed,
+        depth_clear, submission, true, true);
+    REXGPU_INFO("VENOM_SBS892_RECORD HRESULT=0x{:08X} submission={}",
+                uint32_t(context.result), submission);
+  }
+  if (FAILED(context.result)) {
+    REXGPU_ERROR("VENOM_SBS_GAMEPLAY_PAIR_RECORD_FAILED HRESULT=0x{:08X} submission={} count={} indexed={} diagnostic_not_stereo=true",
+                 uint32_t(context.result), submission,
+                 draw_count, indexed);
+  } else {
+    REXGPU_INFO("VENOM_SBS_GAMEPLAY_PAIR_RECORDED HRESULT=0x{:08X} submission={} count={} indexed={} diagnostic_not_stereo=true",
+                uint32_t(context.result), submission,
+                draw_count, indexed);
+  }
+  return context.result;
+}
