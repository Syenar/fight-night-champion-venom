+  }
+  list.D3DEndQuery(probe.heap.Get(), D3D12_QUERY_TYPE_PIPELINE_STATISTICS, index);
+  list.D3DResolveQueryData(probe.heap.Get(), D3D12_QUERY_TYPE_PIPELINE_STATISTICS, index, 1,
+                          probe.results.Get(),
+                          UINT64(index) * sizeof(D3D12_QUERY_DATA_PIPELINE_STATISTICS));
