+bool Sbs317Append(char* buffer, size_t capacity, size_t& offset, const char* format, ...) {
+  if (offset >= capacity) return false;
+  va_list args;
+  va_start(args, format);
+  int written = std::vsnprintf(buffer + offset, capacity - offset, format, args);
+  va_end(args);
+  if (written < 0 || static_cast<size_t>(written) >= capacity - offset) return false;
+  offset += static_cast<size_t>(written);
+  return true;
+}
+
+bool Sbs317AppendFloat(char* buffer, size_t capacity, size_t& offset, float value) {
+  return std::isfinite(value) ? Sbs317Append(buffer, capacity, offset, "%g", value)
+                              : Sbs317Append(buffer, capacity, offset, "null");
+}
+
+bool Sbs317SafeCaptureDirectory(const wchar_t* path) {
+  if (!path || path[0] != L'D' || path[1] != L':' || path[2] != L'\\') return false;
+  if (GetDriveTypeW(L"D:\\") != DRIVE_FIXED) return false;
+  wchar_t ancestor[1024] = L"D:\\";
+  size_t length = 3;
+  const wchar_t* component = path + 3;
+  while (*component) {
+    const wchar_t* separator = wcschr(component, L'\\');
+    size_t component_length = separator ? static_cast<size_t>(separator - component)
+                                        : wcslen(component);
+    if (!component_length ||
+        length + component_length + 2 >= sizeof(ancestor) / sizeof(ancestor[0])) return false;
+    if (length > 3) ancestor[length++] = L'\\';
+    wmemcpy(ancestor + length, component, component_length);
+    length += component_length;
+    ancestor[length] = wchar_t();
+    DWORD attributes = GetFileAttributesW(ancestor);
+    if (attributes == INVALID_FILE_ATTRIBUTES || !(attributes & FILE_ATTRIBUTE_DIRECTORY) ||
+        (attributes & FILE_ATTRIBUTE_REPARSE_POINT)) return false;
+    if (!separator) break;
+    component = separator + 1;
+  }
+  return true;
+}
