+  EdramWrapTrace217State& state = GetEdramWrapTrace217State();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (!state.initialized || state.active.load(std::memory_order_relaxed) != trace_enabled) {
+    if (trace_enabled) {
+      state.would_clamp_count = 0;
+      state.actual_clamp_count = 0;
+      state.last_record_tick = host_tick;
+      if (state.records_emitted < 600) {
+        REXGPU_WARN("EDRAM217 trace start: trace=1 clamp_option={} tick_frequency={}",
