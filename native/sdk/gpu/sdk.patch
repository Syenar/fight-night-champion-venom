+                                 address, bytes);
+    commands.D3DCopyBufferRegion(probe.consumer_readback.Get(), 0, shared.GetBuffer(),
+                                 address, PrivateDepthResolve::kLength);
+    // Complete the first copy before replacing the exact resolved prefix.
+    processor.PushTransitionBarrier(probe.texture_source.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+        D3D12_RESOURCE_STATE_COPY_SOURCE);
+    processor.SubmitBarriers();
+    processor.PushTransitionBarrier(probe.texture_source.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE,
+        D3D12_RESOURCE_STATE_COPY_DEST);
+    processor.SubmitBarriers();
+    commands.D3DCopyBufferRegion(probe.texture_source.Get(), 0, probe.target.Get(),
+                                 0, PrivateDepthResolve::kLength);
+    processor.PushTransitionBarrier(probe.texture_source.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    probe.consumer_submission = processor.GetCurrentSubmission();
+    REXGPU_INFO("VENOM_SBS_DEPTH_CONSUMER_BOUND producer_frame={} consumer_frame={} producer_submission={} consumer_submission={} address={:08X} texture_bytes={}",
+                probe.frame, processor.GetCurrentFrame(), probe.submission,
+                probe.consumer_submission, address, bytes);
+    return probe.texture_source.Get();
+  }
+  return nullptr;
+}
