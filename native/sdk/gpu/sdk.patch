+#pragma once
+
+#include <cmath>
+#include <simde/x86/fma.h>
+
+namespace rex::ppc {
+// Vectors are passed by value so guest destination/source register aliases
+// cannot overwrite an operand before all lanes have been evaluated.
+// Preserve the caller's FPSCR rounding and FTZ/DAZ policy.
+inline simde__m128 vector_fma(simde__m128 a, simde__m128 b, simde__m128 c) {
+#if defined(SIMDE_X86_FMA_NATIVE)
+  // Compile-time hardware feature only; the existing SSSE3 target uses fallback.
+  return simde_mm_fmadd_ps(a, b, c);
+#else
+  alignas(16) float av[4], bv[4], cv[4], out[4];
+  simde_mm_store_ps(av, a);
+  simde_mm_store_ps(bv, b);
+  simde_mm_store_ps(cv, c);
+  for (unsigned i = 0; i < 4; ++i) {
+    out[i] = std::fma(av[i], bv[i], cv[i]);
+  }
+  return simde_mm_load_ps(out);
+#endif
+}
+
+inline simde__m128 vector_fms(simde__m128 a, simde__m128 b, simde__m128 c) {
+  // Fused a*b-c. vnmsubfp retains its existing outer sign-bit XOR, including
+  // the signed-zero result of negating a rounded exact cancellation.
+  return vector_fma(a, b, simde_mm_xor_ps(
+      c, simde_mm_castsi128_ps(simde_mm_set1_epi32(int(0x80000000u)))));
+}
