 namespace rex::codegen {
 
 namespace {
+
+// Qualification environments may expose the workspace through a Windows
+// reparse point.  std::filesystem::canonical follows that point and throws
+// before codegen can report a useful project error.  Keep the normal
+// canonical result when possible, but fall back to a normalized absolute
+// path so the isolated qualification can proceed without dereferencing the
+// host's reparse metadata.
+std::filesystem::path CanonicalOrLexical(const std::filesystem::path& path) {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  fs::path result = fs::canonical(path, ec);
+  if (!ec)
+    return result;
+  ec.clear();
+  result = fs::absolute(path, ec);
+  if (!ec)
+    return result.lexically_normal();
+  return path.lexically_normal();
+}
+
+std::filesystem::path RelativeOrLexical(const std::filesystem::path& path,
+                                        const std::filesystem::path& base) {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  fs::path result = fs::relative(path, base, ec);
+  if (!ec)
+    return result;
+  result = path.lexically_normal().lexically_relative(base.lexically_normal());
+  return result.empty() ? path.lexically_normal() : result;
+}
 
 std::string DeriveTargetNameFromFilePath(const std::string& file_path) {
   std::filesystem::path p(file_path);
