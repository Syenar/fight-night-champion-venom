+bool D3D12RenderTargetCache::SnapshotBoundHostTargets778(
+    BoundHostTargetsSnapshot778& out) const {
+  out = BoundHostTargetsSnapshot778{};
+  if (GetPath() != Path::kHostRenderTargets ||
+      !are_current_command_list_render_targets_valid_) {
+    return false;
+  }
+
+  std::array<const RenderTarget*, 1 + xenos::kMaxColorRenderTargets> targets{};
+  static_assert(1 + xenos::kMaxColorRenderTargets == 5,
+                "snapshot resource slots must match depth plus four color targets");
+  static_assert(sizeof(targets) == sizeof(current_command_list_render_targets_),
+                "cached render target pointer layout must match snapshot view");
+  std::memcpy(targets.data(), current_command_list_render_targets_, sizeof(targets));
+
+  bool any_target = false;
+  for (size_t i = 0; i < targets.size(); ++i) {
+    const RenderTarget* target = targets[i];
+    if (!target) {
+      continue;
+    }
+    any_target = true;
+    const auto& key = target->key();
+    if (key.is_depth != (i == 0)) {
+      out = BoundHostTargetsSnapshot778{};
+      return false;
+    }
+    const auto& d3d12_target = *static_cast<const D3D12RenderTarget*>(target);
+    out.resources[i] = d3d12_target.resource();
+    out.resource_descs[i] = out.resources[i]->GetDesc();
+    out.guest_rt_keys[i] = key.key;
+    if (i == 0) {
+      out.dsv_format = GetDepthDSVDXGIFormat(key.GetDepthFormat());
+      if (out.dsv_format == DXGI_FORMAT_UNKNOWN) {
+        out = BoundHostTargetsSnapshot778{};
+        return false;
+      }
+    } else {
+      out.rtv_formats[i - 1] = GetColorDrawDXGIFormat(key.GetColorFormat());
+      if (out.rtv_formats[i - 1] == DXGI_FORMAT_UNKNOWN) {
+        out = BoundHostTargetsSnapshot778{};
+        return false;
+      }
+    }
+  }
+  if (!any_target) {
+    out = BoundHostTargetsSnapshot778{};
+    return false;
+  }
+
+  out.has_depth = targets[0] != nullptr;
+  if (out.has_depth) {
+    out.dsv_handle = static_cast<const D3D12RenderTarget*>(targets[0])
+                         ->descriptor_draw()
+                         .GetHandle();
+  }
+
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    const RenderTarget* target = targets[1 + i];
+    if (!target) {
+      continue;
+    }
+    while (out.rtv_count < i) {
+      out.rtv_handles[out.rtv_count++] =
+          target->key().msaa_samples != xenos::MsaaSamples::k1X
+              ? null_rtv_descriptor_ms_.GetHandle()
+              : null_rtv_descriptor_ss_.GetHandle();
+    }
+    const auto& d3d12_target = *static_cast<const D3D12RenderTarget*>(target);
+    out.rtv_handles[out.rtv_count++] = d3d12_target.descriptor_draw().GetHandle();
+  }
+  return true;
+}
