+// Local source-only checked host I/O for the Windows DLC importer.
+#pragma once
+#include <algorithm>
+#include <cstdio>
+#include <cstdint>
+#include <filesystem>
+#include <set>
+#include <string>
+#include <vector>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <fcntl.h>
+#include <io.h>
+#endif
+
+namespace rex::system::dlc_io {
+
+inline bool EqualComponent(const std::wstring& a, const std::wstring& b) {
+#ifdef _WIN32
+  return CompareStringOrdinal(a.data(), static_cast<int>(a.size()), b.data(),
+                               static_cast<int>(b.size()), TRUE) == CSTR_EQUAL;
+#else
+  return a == b;
+#endif
+}
+struct PathLess {
+  bool operator()(const std::wstring& a, const std::wstring& b) const {
+#ifdef _WIN32
+    return CompareStringOrdinal(a.data(), static_cast<int>(a.size()), b.data(),
+                                 static_cast<int>(b.size()), TRUE) == CSTR_LESS_THAN;
+#else
+    return a < b;
+#endif
+  }
+};
+using SeenEntries = std::set<std::wstring, PathLess>;
+
+// Fail closed on unsupported non-ASCII names; do not silently normalize aliases.
+// Validate original bytes before any host-path append/separator normalization.
+inline bool SafeComponent(const std::string& component) {
+  if (component.empty() || component == "." || component == ".." ||
+      component.back() == '.' || component.back() == ' ') return false;
+  for (unsigned char ch : component) {
+    if (ch < 32 || ch >= 127 || std::string("<>:\"/\\|?*").find(ch) != std::string::npos)
+      return false;
+  }
+  auto stem = component.substr(0, component.find('.'));
+  std::transform(stem.begin(), stem.end(), stem.begin(), [](unsigned char ch) {
+    return static_cast<char>(ch >= 'a' && ch <= 'z' ? ch - ('a' - 'A') : ch);
+  });
+  if (stem == "CON" || stem == "PRN" || stem == "AUX" || stem == "NUL" ||
+      stem == "CLOCK$" || stem == "CONIN$" || stem == "CONOUT$") return false;
+  if (stem.size() == 4 && (stem.substr(0, 3) == "COM" || stem.substr(0, 3) == "LPT") &&
+      stem[3] >= '0' && stem[3] <= '9') return false;
+  return true;
+}
+
+inline bool CheckedEntryPath(const std::string& raw, bool directory,
+                             const std::filesystem::path& base,
+                             std::filesystem::path& destination, SeenEntries& seen) {
+  if (!base.is_absolute()) return false;
+  // STFS parser's empty directory root is legitimate, once per package.
+  if (raw.empty()) {
+    if (!directory || !seen.insert(L"").second) return false;
+    destination = base.lexically_normal();
+    return true;
+  }
+  if (raw.front() == '/' || raw.front() == '\\') return false;
+  std::filesystem::path relative;
+  size_t begin = 0;
+  for (size_t end = 0; end <= raw.size(); ++end) {
+    if (end != raw.size() && raw[end] != '/' && raw[end] != '\\') continue;
+    const auto component = raw.substr(begin, end - begin);
+    if (!SafeComponent(component)) return false;
+    relative /= component;
+    begin = end + 1;
+  }
+  if (relative.has_root_name() || relative.has_root_directory() || relative.is_absolute())
+    return false;
+  const auto normalized_base = base.lexically_normal();
+  destination = (normalized_base / relative).lexically_normal();
+  auto child = destination.begin();
+  for (auto parent = normalized_base.begin(); parent != normalized_base.end(); ++parent, ++child) {
+    if (child == destination.end() || !EqualComponent(parent->wstring(), child->wstring()))
+      return false;
+  }
+  if (child == destination.end()) return false;
+  return seen.insert(relative.generic_wstring()).second;
+}
+
+// Hold every ancestor directory open without FILE_SHARE_DELETE through the
+// operation. Open each component itself, reject reparse points, then descend.
+// This prevents a parent rename/reparse swap while a file is being written.
+class LockedDirectories {
+ public:
+  LockedDirectories() = default;
+  LockedDirectories(const LockedDirectories&) = delete;
+  LockedDirectories& operator=(const LockedDirectories&) = delete;
+  ~LockedDirectories() {
+#ifdef _WIN32
+    for (auto handle : handles_) CloseHandle(handle);
+#endif
+  }
+  bool Lock(const std::filesystem::path& path, bool create) {
+#ifdef _WIN32
+    if (!path.is_absolute() || path.root_name().wstring().size() != 2 ||
+        path.root_name().wstring()[1] != L':') return false;  // no UNC/device roots
+    std::filesystem::path current = path.root_path();
+    if (!LockOne(current)) return false;
+    for (const auto& component : path.relative_path()) {
+      if (component == L"." || component == L".." || component.empty()) return false;
+      current /= component;
+      if (create && !CreateDirectoryW(current.c_str(), nullptr) &&
+          GetLastError() != ERROR_ALREADY_EXISTS) return false;
+      if (!LockOne(current)) return false;
+    }
+    return true;
+#else
+    return false;  // Windows source candidate: no unreviewed portable fallback
+#endif
+  }
+  bool CreateExclusive(const std::filesystem::path& path) {
+#ifdef _WIN32
+    if (!Lock(path.parent_path(), true) || !CreateDirectoryW(path.c_str(), nullptr)) return false;
+    return LockOne(path);
+#else
+    return false;
+#endif
+  }
+ private:
+#ifdef _WIN32
+  bool LockOne(const std::filesystem::path& path) {
+    auto handle = CreateFileW(path.c_str(), FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                              nullptr, OPEN_EXISTING,
+                              FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+    if (handle == INVALID_HANDLE_VALUE) return false;
+    BY_HANDLE_FILE_INFORMATION info{};
+    if (!GetFileInformationByHandle(handle, &info) ||
+        !(info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) ||
+        (info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT)) {
+      CloseHandle(handle);
+      return false;
+    }
+    handles_.push_back(handle);
+    return true;
+  }
+  std::vector<HANDLE> handles_;
+#endif
+};
+
+inline FILE* OpenFileChecked(const std::filesystem::path& path, bool create_new,
+                             LockedDirectories& parents) {
+#ifdef _WIN32
+  if (!parents.Lock(path.parent_path(), create_new)) return nullptr;
+  auto handle = CreateFileW(path.c_str(), create_new ? GENERIC_WRITE : GENERIC_READ,
+                            FILE_SHARE_READ, nullptr, create_new ? CREATE_NEW : OPEN_EXISTING,
+                            FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+  if (handle == INVALID_HANDLE_VALUE) return nullptr;
+  BY_HANDLE_FILE_INFORMATION info{};
+  if (!GetFileInformationByHandle(handle, &info) ||
+      (info.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT))) {
+    CloseHandle(handle);
+    return nullptr;
+  }
+  const int fd = _open_osfhandle(reinterpret_cast<intptr_t>(handle),
+                                _O_BINARY | (create_new ? _O_WRONLY : _O_RDONLY));
+  if (fd == -1) { CloseHandle(handle); return nullptr; }
+  auto* file = _fdopen(fd, create_new ? "wb" : "rb");
+  if (!file) _close(fd);
+  return file;
+#else
+  return nullptr;
+#endif
+}
+
+// Rename the opened source itself, not a raceable path, and never replace a
+// destination. Parent locks prevent traversal/rename of the destination chain.
+inline bool RenameNoReplace(const std::filesystem::path& from, const std::filesystem::path& to) {
+#ifdef _WIN32
+  LockedDirectories source_parents, target_parents;
+  if (!source_parents.Lock(from.parent_path(), false) ||
+      !target_parents.Lock(to.parent_path(), false)) return false;
+  auto handle = CreateFileW(from.c_str(), DELETE | FILE_READ_ATTRIBUTES, FILE_SHARE_READ, nullptr,
+                            OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+  if (handle == INVALID_HANDLE_VALUE) return false;
+  BY_HANDLE_FILE_INFORMATION info{};
+  if (!GetFileInformationByHandle(handle, &info) ||
+      (info.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT))) {
+    CloseHandle(handle); return false;
+  }
+  const auto target = to.wstring();
+  std::vector<unsigned char> buffer(sizeof(FILE_RENAME_INFO) + target.size() * sizeof(wchar_t));
+  auto* rename = reinterpret_cast<FILE_RENAME_INFO*>(buffer.data());
+  rename->ReplaceIfExists = FALSE;
+  rename->RootDirectory = nullptr;
+  rename->FileNameLength = static_cast<DWORD>(target.size() * sizeof(wchar_t));
+  std::copy(target.begin(), target.end(), rename->FileName);
+  const bool ok = SetFileInformationByHandle(handle, FileRenameInfo, rename,
+                                             static_cast<DWORD>(buffer.size())) != 0;
+  CloseHandle(handle);
+  return ok;
+#else
+  return false;
+#endif
+}
+}  // namespace rex::system::dlc_io
