+bool WriteExclusiveGameplayFile801(const std::wstring& path, const std::uint8_t* bytes,
+                                  std::size_t size) {
+  HANDLE file = CreateFileW(path.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW,
+                            FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+  if (file == INVALID_HANDLE_VALUE) return false;
+  bool succeeded = true;
+  std::size_t offset = 0;
+  constexpr std::size_t kChunkBytes = 1024 * 1024;
+  while (offset < size) {
+    const DWORD request = static_cast<DWORD>(std::min(kChunkBytes, size - offset));
+    DWORD written = 0;
+    if (!WriteFile(file, bytes + offset, request, &written, nullptr) || written != request) {
+      succeeded = false;
