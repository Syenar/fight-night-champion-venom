+std::string LowerPath(std::filesystem::path path) {
+  auto value = path.lexically_normal().generic_string();
+  std::transform(value.begin(), value.end(), value.begin(),
+                 [](unsigned char ch) { return static_cast<char>(std::tolower(ch)); });
+  return value;
+}
+
+bool IsWithinPath(const std::filesystem::path& child, const std::filesystem::path& parent) {
+  const auto child_text = LowerPath(child);
+  auto parent_text = LowerPath(parent);
+  if (child_text == parent_text) return true;
+  if (!parent_text.empty() && parent_text.back() != '/') parent_text.push_back('/');
+  return child_text.rfind(parent_text, 0) == 0;
+}
+
+bool HasReparseOrSymlinkComponent(const std::filesystem::path& path) {
+  std::error_code ec;
+  auto absolute = std::filesystem::absolute(path, ec).lexically_normal();
+  if (ec) return true;
+  for (auto component = absolute; !component.empty(); component = component.parent_path()) {
+    ec.clear();
+    const auto status = std::filesystem::symlink_status(component, ec);
+    if (ec && ec != std::errc::no_such_file_or_directory) return true;
+    if (!ec && std::filesystem::is_symlink(status)) return true;
+#ifdef _WIN32
+    const auto attributes = GetFileAttributesW(component.c_str());
+    if (attributes != INVALID_FILE_ATTRIBUTES && (attributes & FILE_ATTRIBUTE_REPARSE_POINT)) return true;
+#endif
+    if (component == component.root_path()) break;
+  }
+  return false;
+}
+
+bool ReadExactMarker(const std::filesystem::path& path, std::string_view expected) {
+  if (HasReparseOrSymlinkComponent(path)) return false;
+  std::ifstream input(path, std::ios::binary);
+  if (!input) return false;
+  std::string value((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+  if (!value.empty() && value.back() == '\n') value.pop_back();
+  if (!value.empty() && value.back() == '\r') value.pop_back();
+  return value == expected;
+}
+
+bool IsNonce(std::string_view value) {
+  return value.size() == 32 && std::all_of(value.begin(), value.end(), [](unsigned char ch) {
+    return (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f');
+  });
+}
