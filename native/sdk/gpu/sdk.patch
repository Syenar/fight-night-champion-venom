+                    "\"max_total_bytes\":16777216,\"truncated\":false,\"error\":false,"
+                    "\"shader_dictionary\":{\"max_tuples\":128,\"max_dwords_per_shader\":8192,"
+                    "\"max_dwords_per_chunk\":128,\"word_encoding\":\"host_endian_numeric_raw32\"},"
+                    "\"scope\":\"renderer diagnostics; raw register facts only; no matrix identification\"}",
+                    escaped_path)) {
+    reason = L"header buffer overflow";
+    goto open_error;
+  }
+
+  if (GetFileAttributesW(full_path) != INVALID_FILE_ATTRIBUTES) {
+    reason = L"output already exists; CREATE_NEW required";
+    goto open_error;
+  }
+
+  sbs317_trace_file_ = CreateFileW(full_path, GENERIC_WRITE | DELETE, 0, nullptr, CREATE_NEW,
+                                   FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+  if (sbs317_trace_file_ == INVALID_HANDLE_VALUE) {
+    reason = L"CREATE_NEW failed";
+    goto open_error;
+  }
+  {
+    DWORD written = 0;
+    if (!WriteFile(sbs317_trace_file_, header, static_cast<DWORD>(header_length), &written,
+                   nullptr) || written != header_length) {
+      reason = L"header write failed";
+      sbs317_trace_bytes_ = written;
+      goto open_error;
+    }
+    sbs317_trace_bytes_ = written;
+    if (!WriteFile(sbs317_trace_file_, "\n", 1, &written, nullptr) || written != 1) {
+      reason = L"header newline write failed";
+      sbs317_trace_bytes_ += written;
+      goto open_error;
+    }
+    sbs317_trace_bytes_ += written;
+  }
+  return true;
+
+open_error:
+  sbs317_trace_error_ = true;
+  sbs317_trace_terminal_reason_ = "open_error";
+  {
+    char reason_utf8[256] = {};
+    char requested_utf8[kPathCapacity * 4] = {};
+    WideCharToMultiByte(CP_UTF8, 0, configured_path, -1, requested_utf8,
+                        sizeof(requested_utf8), nullptr, nullptr);
+    WideCharToMultiByte(CP_UTF8, 0, reason, -1, reason_utf8, sizeof(reason_utf8), nullptr, nullptr);
+    REXGPU_WARN("SBS317 GPU trace did not start: {} path={} (winerr {})", reason_utf8,
+                requested_utf8[0] ? requested_utf8 : "(unset)", GetLastError());
+  }
+  if (sbs317_trace_file_ != INVALID_HANDLE_VALUE) {
+    // CREATE_NEW proved this handle created the file. Keep a terminal status
+    // line even if the header write was partial, then flush and close it.
+    Sbs317TraceFinish();
+  } else {
+    sbs317_trace_complete_ = true;
+  }
+  return false;
+}
+
+void D3D12CommandProcessor::Sbs317TraceFinish() {
+  if (sbs317_trace_complete_) return;
+  sbs317_trace_complete_ = true;
+  if (sbs317_trace_file_ == INVALID_HANDLE_VALUE) return;
+  char footer[256];
+  int length = std::snprintf(
+      footer, sizeof(footer),
+      "{\"type\":\"status\",\"reason\":\"%s\",\"truncated\":%s,\"error\":%s,"
+      "\"frames\":%u,\"bytes_before_status\":%llu}\n",
+      sbs317_trace_terminal_reason_, sbs317_trace_truncated_ ? "true" : "false",
+      sbs317_trace_error_ ? "true" : "false", sbs317_trace_frame_count_,
+      static_cast<unsigned long long>(sbs317_trace_bytes_));
+  DWORD written = 0;
+  if (length > 0 && sbs317_trace_bytes_ + static_cast<uint64_t>(length) <= 16 * 1024 * 1024 &&
+      WriteFile(sbs317_trace_file_, footer, static_cast<DWORD>(length), &written, nullptr) &&
+      written == static_cast<DWORD>(length) && FlushFileBuffers(sbs317_trace_file_)) {
+    sbs317_trace_bytes_ += written;
+  } else {
+    sbs317_trace_error_ = true;
+    REXGPU_WARN("SBS317 GPU trace terminal status/flush failed");
+    if (std::strcmp(sbs317_trace_terminal_reason_, "open_error") == 0) {
+      // This is still the exclusive handle created by our validated CREATE_NEW
+      // request. If its startup footer cannot be persisted, delete that exact
+      // file by handle when closing, without a racy path-based delete.
+      FILE_DISPOSITION_INFO disposition{};
+      disposition.DeleteFile = TRUE;
+      if (!SetFileInformationByHandle(sbs317_trace_file_, FileDispositionInfo, &disposition,
+                                      sizeof(disposition))) {
+        REXGPU_WARN("SBS317 GPU trace failed to remove incomplete startup output");
+      }
+    }
+  }
+  CloseHandle(sbs317_trace_file_);
+  sbs317_trace_file_ = INVALID_HANDLE_VALUE;
+}
+
+void D3D12CommandProcessor::Sbs317TraceLoadTriggerConfig() {
+  sbs317_trace_trigger_config_loaded_ = true;
+  SetLastError(ERROR_SUCCESS);
+  DWORD token_length = GetEnvironmentVariableW(L"REX_SBS354_TRACE_TRIGGER_TOKEN",
+                                              sbs317_trace_trigger_token_,
+                                              _countof(sbs317_trace_trigger_token_));
+  DWORD env_error = GetLastError();
+  if (!token_length && env_error == ERROR_ENVVAR_NOT_FOUND) {
+    // No token configured: retain the original CVar-only arming behavior.
+    return;
+  }
+  sbs317_trace_trigger_required_ = true;
+  bool token_valid = token_length == 32;
+  for (size_t i = 0; token_valid && i < 32; ++i) {
+    wchar_t c = sbs317_trace_trigger_token_[i];
+    token_valid = (c >= L'0' && c <= L'9') || (c >= L'a' && c <= L'f') ||
+                  (c >= L'A' && c <= L'F');
+  }
+  sbs317_trace_trigger_valid_ = token_valid;
+  if (!token_valid) {
+    REXGPU_WARN("SBS354 GPU trace trigger token must contain exactly 32 hex characters");
+  }
+}
+
+bool D3D12CommandProcessor::Sbs317TracePollTrigger() {
+  if (sbs317_trace_started_ || sbs317_trace_complete_ || sbs317_trace_trigger_accepted_ ||
+      !REXCVAR_GET(venom_sbs_trace317_arm) || !sbs317_trace_trigger_config_loaded_ ||
+      !sbs317_trace_trigger_required_ || !sbs317_trace_trigger_valid_) {
+    return false;
+  }
+
+  const auto now = std::chrono::steady_clock::now();
+  constexpr auto kTriggerPollPeriod = std::chrono::milliseconds(250);
+  if (sbs317_trace_has_trigger_poll_ &&
+      now - sbs317_trace_last_trigger_poll_ < kTriggerPollPeriod) {
+    return false;
+  }
+  sbs317_trace_last_trigger_poll_ = now;
+  sbs317_trace_has_trigger_poll_ = true;
+
+  constexpr DWORD kPathCapacity = 1024;
+  wchar_t captures_path[kPathCapacity] = {};
+  wchar_t trigger_path[kPathCapacity] = {};
+  wcscpy_s(captures_path,
+           L"D:\\Fight Night Champion Venom\\xbox-full-game-sbs\\research\\active-work\\cap161651-gameplay-eye-pair");
+  if (!Sbs317SafeCaptureDirectory(captures_path)) return false;
+  int trigger_path_length = _snwprintf_s(
+      trigger_path, _countof(trigger_path), _TRUNCATE, L"%s\\arm-%s.txt", captures_path,
+      sbs317_trace_trigger_token_);
+  if (trigger_path_length < 0) return false;
+  DWORD attributes = GetFileAttributesW(trigger_path);
+  if (attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_DIRECTORY) ||
+      (attributes & FILE_ATTRIBUTE_REPARSE_POINT)) {
+    return false;
+  }
+
+  HANDLE trigger_file = CreateFileW(trigger_path, GENERIC_READ, FILE_SHARE_READ, nullptr,
+                                    OPEN_EXISTING,
+                                    FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+  if (trigger_file == INVALID_HANDLE_VALUE) return false;
+  BY_HANDLE_FILE_INFORMATION file_info{};
+  bool regular_file = GetFileType(trigger_file) == FILE_TYPE_DISK &&
+                      GetFileInformationByHandle(trigger_file, &file_info) &&
+                      !(file_info.dwFileAttributes &
+                        (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT));
+  char token_contents[33] = {};
+  DWORD bytes_read = 0;
+  bool token_matches = regular_file &&
+                       ReadFile(trigger_file, token_contents, sizeof(token_contents), &bytes_read,
+                                nullptr) &&
+                       bytes_read == 32;
+  if (token_matches) {
+    for (size_t i = 0; i < 32; ++i) {
+      if (static_cast<unsigned char>(token_contents[i]) !=
+          static_cast<unsigned char>(sbs317_trace_trigger_token_[i])) {
+        token_matches = false;
+        break;
+      }
+    }
+  }
+  CloseHandle(trigger_file);
+  if (!token_matches) return false;
+
+  sbs317_trace_trigger_accepted_ = true;
+  REXGPU_WARN("SBS354 GPU trace trigger accepted at a swap boundary");
+  return true;
+}
+
+bool D3D12CommandProcessor::Sbs317TraceBeginRecord(uint64_t frame, bool draw_record,
+                                                   uint32_t& ordinal) {
+  if (sbs317_trace_complete_) return false;
+  if (!sbs317_trace_started_) {
+    if (!sbs317_trace_arm_seen_) {
+      if (!REXCVAR_GET(venom_sbs_trace317_arm)) return false;
+      if (!sbs317_trace_trigger_config_loaded_) return false;
+      if (sbs317_trace_trigger_required_ && !sbs317_trace_trigger_accepted_) return false;
+      sbs317_trace_arm_seen_ = true;
+      sbs317_trace_arm_frame_ = frame;
+      return false;
+    }
+    if (frame == sbs317_trace_arm_frame_) return false;
+    // Begin with actual geometry/copy work in the next frame; a swap packet
+    // alone is not a complete frame record.
+    if (!draw_record) return false;
+    if (!Sbs317TraceStart()) return false;
+  }
+  if (sbs317_trace_file_ == INVALID_HANDLE_VALUE || sbs317_trace_truncated_ || sbs317_trace_error_) {
+    return false;
+  }
+  if (frame != sbs317_trace_last_frame_) {
+    if (sbs317_trace_frame_count_ == 2) {
+      sbs317_trace_truncated_ = true;
+      sbs317_trace_terminal_reason_ = "frame_limit";
+      Sbs317TraceFinish();
+      return false;
+    }
+    sbs317_trace_last_frame_ = frame;
+    ++sbs317_trace_frame_count_;
+    sbs317_trace_draw_count_ = 0;
+  }
+  if (draw_record) {
+    if (sbs317_trace_draw_count_ == 2048) {
+      sbs317_trace_truncated_ = true;
+      sbs317_trace_terminal_reason_ = "draw_limit";
+      Sbs317TraceFinish();
+      return false;
+    }
+    ordinal = sbs317_trace_draw_count_;
+    ++sbs317_trace_draw_count_;
+  } else {
+    ordinal = sbs317_trace_draw_count_;
+  }
+  return true;
+}
+
+void D3D12CommandProcessor::Sbs317TraceWrite(const char* line, size_t length) {
+  if (sbs317_trace_file_ == INVALID_HANDLE_VALUE || sbs317_trace_truncated_ || sbs317_trace_error_) {
+    return;
+  }
+  // Reserve room for the final status record so every bounded trace reports
+  // whether it was complete, truncated, or affected by an output error.
+  constexpr uint64_t kStatusReserve = 256;
+  if (length + 1 > 16 * 1024 * 1024 - kStatusReserve - sbs317_trace_bytes_) {
+    sbs317_trace_truncated_ = true;
+    sbs317_trace_terminal_reason_ = "byte_limit";
+    Sbs317TraceFinish();
+    return;
+  }
+  DWORD written = 0;
+  if (!WriteFile(sbs317_trace_file_, line, static_cast<DWORD>(length), &written,
+                 nullptr) || written != static_cast<DWORD>(length) ||
+      !WriteFile(sbs317_trace_file_, "\n", 1, &written, nullptr) || written != 1) {
+    sbs317_trace_error_ = true;
+    sbs317_trace_terminal_reason_ = "write_error";
+    REXGPU_WARN("SBS317 GPU trace record write failed");
+    Sbs317TraceFinish();
+    return;
+  }
+  sbs317_trace_bytes_ += length + 1;
+}
+
+__declspec(noinline) void D3D12CommandProcessor::Sbs317TraceCopyRecord(
+    uint64_t frame, uint32_t ordinal, const RegisterFile& regs, bool resolve_success,
+    uint32_t written_address, uint32_t written_length, uint32_t readback_mode_raw,
+    bool readback_path) {
+  char trace[1024];
+  size_t length = 0;
+  const uint32_t recorded_address = resolve_success ? written_address : 0;
+  const uint32_t recorded_length = resolve_success ? written_length : 0;
+  const bool output_valid = resolve_success;
+  const bool output_range_valid = resolve_success && written_length != 0;
+  if (Sbs317Append(trace, sizeof(trace), length,
+                   "{\"type\":\"copy\",\"frame\":%llu,\"ordinal\":%u,"
+                   "\"color_rt_raw32\":[%u,%u,%u,%u],\"depth_rt_raw32\":%u,\"vte_raw32\":%u,"
+                   "\"shader_analysis\":false,\"memexport_vertex\":false,"
+                   "\"memexport_pixel\":false,\"vertex_float_constants_raw32\":[],"
+                   "\"resolve_success\":%s,\"written_address_valid\":%s,"
+                   "\"written_length_valid\":%s,\"resolve_output_range_valid\":%s,"
+                   "\"written_address_raw32\":%u,\"written_length_raw32\":%u,"
+                   "\"copy_control_raw32\":%u,\"copy_dest_base_raw32\":%u,"
+                   "\"copy_dest_pitch_raw32\":%u,\"copy_dest_info_raw32\":%u,"
+                   "\"readback_mode_raw\":%u,\"readback_path\":%s,"
+                   "\"logical_guest_written_range\":{\"valid\":%s,\"address_raw32\":%u,"
+                   "\"length_raw32\":%u},\"resource_identity\":\"UNKNOWN\",\"target_register_correlation_scope\":\"frame_and_raw_color_depth_registers_only\"}",
+                   static_cast<unsigned long long>(frame), ordinal,
+                   regs[reg::RB_COLOR_INFO::rt_register_indices[0]],
+                   regs[reg::RB_COLOR_INFO::rt_register_indices[1]],
+                   regs[reg::RB_COLOR_INFO::rt_register_indices[2]],
+                   regs[reg::RB_COLOR_INFO::rt_register_indices[3]],
+                   regs.Get<reg::RB_DEPTH_INFO>().value, regs[XE_GPU_REG_PA_CL_VTE_CNTL],
+                   resolve_success ? "true" : "false", output_valid ? "true" : "false",
+                   output_valid ? "true" : "false", output_range_valid ? "true" : "false",
+                   recorded_address, recorded_length,
+                   regs[XE_GPU_REG_RB_COPY_CONTROL], regs[XE_GPU_REG_RB_COPY_DEST_BASE],
+                   regs[XE_GPU_REG_RB_COPY_DEST_PITCH], regs[XE_GPU_REG_RB_COPY_DEST_INFO],
+                   readback_mode_raw,
+                   readback_path ? "true" : "false", output_range_valid ? "true" : "false",
+                   recorded_address, recorded_length)) {
+    Sbs317TraceWrite(trace, length);
+  } else {
+    sbs317_trace_truncated_ = true;
+    sbs317_trace_terminal_reason_ = "record_buffer_limit";
+    Sbs317TraceFinish();
+  }
+}
+bool D3D12CommandProcessor::Sbs317TraceShaderDictionaryRecord(
+    uint64_t frame, uint32_t ordinal, const D3D12Shader* shader, const char* stage,
+    uint8_t stage_id, uint64_t modification) {
+  auto fail = [this](const char* reason) {
+    sbs317_trace_truncated_ = true;
+    sbs317_trace_terminal_reason_ = reason;
+    Sbs317TraceFinish();
+    return false;
+  };
+  if (!shader) return fail("shader_dictionary_missing_shader");
+  if (sbs317_trace_file_ == INVALID_HANDLE_VALUE || sbs317_trace_truncated_ ||
+      sbs317_trace_error_) {
+    return false;
+  }
+  const uint32_t* words = shader->ucode_dwords();
+  const size_t word_count = shader->ucode_dword_count();
+  const uint64_t shader_hash = shader->ucode_data_hash();
+  if (!words || !word_count) return fail("shader_dictionary_missing_ucode");
+  constexpr size_t kMaxShaderDwords = 8192;
+  constexpr size_t kChunkDwords = 128;
+  constexpr uint32_t kMaxShaderTuples = 128;
+  static_assert(std::tuple_size_v<decltype(sbs317_shader_dictionary_)> == kMaxShaderTuples,
+                "Trace shader dictionary capacity mismatch");
+  if (word_count > kMaxShaderDwords) return fail("shader_dictionary_word_limit");
+  for (uint32_t i = 0; i < sbs317_shader_dictionary_count_; ++i) {
+    const Sbs317ShaderDictionaryEntry& entry = sbs317_shader_dictionary_[i];
+    if (entry.stage_id == stage_id && entry.ucode_hash == shader_hash &&
+        entry.modification == modification) {
+      if (entry.word_count != word_count) return fail("shader_dictionary_key_conflict");
+      return true;
+    }
+  }
+  if (sbs317_shader_dictionary_count_ >= kMaxShaderTuples) {
+    return fail("shader_dictionary_tuple_limit");
+  }
+
+  char record[2048];
+  size_t length = 0;
+  if (!Sbs317Append(record, sizeof(record), length,
+                    "{\"type\":\"shader_dictionary_begin\",\"frame\":%llu,"
+                    "\"ordinal\":%u,\"stage\":\"%s\",\"ucode_hash\":\"%016llx\","
+                    "\"modification_value_raw64\":\"%016llx\",\"word_offset\":0,"
+                    "\"word_count\":%u,\"word_encoding\":\"host_endian_numeric_raw32\"}",
+                    static_cast<unsigned long long>(frame), ordinal, stage,
+                    static_cast<unsigned long long>(shader_hash),
+                    static_cast<unsigned long long>(modification),
+                    static_cast<unsigned int>(word_count))) {
+    return fail("shader_dictionary_record_buffer_limit");
+  }
+  Sbs317TraceWrite(record, length);
+  if (sbs317_trace_file_ == INVALID_HANDLE_VALUE || sbs317_trace_truncated_ ||
+      sbs317_trace_error_) {
+    return false;
+  }
+
+  for (size_t offset = 0; offset < word_count;) {
+    const size_t remaining = word_count - offset;
+    const size_t chunk_count = remaining < kChunkDwords ? remaining : kChunkDwords;
+    length = 0;
+    bool valid = Sbs317Append(
+        record, sizeof(record), length,
+        "{\"type\":\"shader_dictionary_chunk\",\"frame\":%llu,"
+        "\"ordinal\":%u,\"stage\":\"%s\",\"ucode_hash\":\"%016llx\","
+        "\"modification_value_raw64\":\"%016llx\",\"word_offset\":%u,"
+        "\"word_count\":%u,\"words_raw32\":[",
+        static_cast<unsigned long long>(frame), ordinal, stage,
+        static_cast<unsigned long long>(shader_hash),
+        static_cast<unsigned long long>(modification), static_cast<unsigned int>(offset),
+        static_cast<unsigned int>(chunk_count));
+    for (size_t i = 0; valid && i < chunk_count; ++i) {
+      valid = (i == 0 || Sbs317Append(record, sizeof(record), length, ",")) &&
+              Sbs317Append(record, sizeof(record), length, "%u", words[offset + i]);
+    }
+    valid = valid && Sbs317Append(record, sizeof(record), length, "]}");
+    if (!valid) return fail("shader_dictionary_record_buffer_limit");
+    Sbs317TraceWrite(record, length);
+    if (sbs317_trace_file_ == INVALID_HANDLE_VALUE || sbs317_trace_truncated_ ||
+        sbs317_trace_error_) {
+      return false;
+    }
+    offset += chunk_count;
+  }
+
+  length = 0;
+  if (!Sbs317Append(record, sizeof(record), length,
+                    "{\"type\":\"shader_dictionary_end\",\"frame\":%llu,"
+                    "\"ordinal\":%u,\"stage\":\"%s\",\"ucode_hash\":\"%016llx\","
+                    "\"modification_value_raw64\":\"%016llx\",\"word_offset\":%u,"
+                    "\"word_count\":0,\"total_word_count\":%u}",
+                    static_cast<unsigned long long>(frame), ordinal, stage,
+                    static_cast<unsigned long long>(shader_hash),
+                    static_cast<unsigned long long>(modification),
+                    static_cast<unsigned int>(word_count),
+                    static_cast<unsigned int>(word_count))) {
+    return fail("shader_dictionary_record_buffer_limit");
+  }
+  Sbs317TraceWrite(record, length);
+  if (sbs317_trace_file_ == INVALID_HANDLE_VALUE || sbs317_trace_truncated_ ||
+      sbs317_trace_error_) {
+    return false;
+  }
+  Sbs317ShaderDictionaryEntry& entry =
+      sbs317_shader_dictionary_[sbs317_shader_dictionary_count_++];
+  entry.stage_id = stage_id;
+  entry.ucode_hash = shader_hash;
+  entry.modification = modification;
+  entry.word_count = static_cast<uint32_t>(word_count);
+  return true;
+}
+
+__declspec(noinline) void D3D12CommandProcessor::Sbs317TraceDrawRecord(
+    uint64_t frame, uint32_t ordinal, uint32_t primitive_type_raw,
+    uint32_t index_count, const IndexBufferInfo* index_buffer_info,
+    const D3D12Shader& vertex_shader,
+    const D3D12Shader* pixel_shader, uint64_t vertex_modification,
+    uint64_t pixel_modification, const RegisterFile& regs,
+    const draw_util::ViewportInfo& viewport_info, uint32_t render_target_path_raw,
+    bool memexport_used_vertex, bool memexport_used_pixel,
+    const uint64_t* referenced_float_constants) {
+  char trace[65536];
+  size_t length = 0;
+  draw_util::Scissor trace_scissor;
+  draw_util::GetScissor(regs, trace_scissor);
+  bool valid = Sbs317Append(trace, sizeof(trace), length,
+                            "{\"type\":\"draw\",\"frame\":%llu,\"ordinal\":%u,"
+                            "\"primitive_type_raw32\":%u,\"index_count\":%u,"
+                            "\"vertex_ucode_hash\":\"%llx\",\"pixel_ucode_hash\":",
+                            static_cast<unsigned long long>(frame), ordinal, primitive_type_raw,
+                            index_count,
+                            static_cast<unsigned long long>(vertex_shader.ucode_data_hash()));
+  if (valid) {
+    valid = pixel_shader
+                ? Sbs317Append(trace, sizeof(trace), length, "\"%llx\"",
+                               static_cast<unsigned long long>(pixel_shader->ucode_data_hash()))
+                : Sbs317Append(trace, sizeof(trace), length, "null");
+  }
+  if (valid) {
+    valid = index_buffer_info
+                ? Sbs317Append(
+                      trace, sizeof(trace), length,
+                      ",\"index_buffer\":{\"format_raw\":%u,\"endianness_raw\":%u,"
+                      "\"count\":%u,\"guest_base_raw32\":%u,\"length_bytes\":%llu}",
+                      static_cast<uint32_t>(index_buffer_info->format),
+                      static_cast<uint32_t>(index_buffer_info->endianness),
+                      index_buffer_info->count, index_buffer_info->guest_base,
+                      static_cast<unsigned long long>(index_buffer_info->length))
+                : Sbs317Append(trace, sizeof(trace), length, ",\"index_buffer\":null");
+  }
+  valid = valid && Sbs317Append(
+                       trace, sizeof(trace), length,
+                       ",\"vertex_shader\":{\"stage\":\"VS\",\"ucode_hash\":\"%016llx\","
+                       "\"ucode_dword_count\":%u,\"modification_value_raw64\":\"%016llx\"},"
+                       "\"pixel_shader\":",
+                       static_cast<unsigned long long>(vertex_shader.ucode_data_hash()),
+                       static_cast<unsigned int>(vertex_shader.ucode_dword_count()),
+                       static_cast<unsigned long long>(vertex_modification));
+  if (valid) {
+    valid = pixel_shader
+                ? Sbs317Append(trace, sizeof(trace), length,
+                               "{\"stage\":\"PS\",\"ucode_hash\":\"%016llx\","
+                               "\"ucode_dword_count\":%u,\"modification_value_raw64\":\"%016llx\"}",
+                               static_cast<unsigned long long>(pixel_shader->ucode_data_hash()),
+                               static_cast<unsigned int>(pixel_shader->ucode_dword_count()),
+                               static_cast<unsigned long long>(pixel_modification))
+                : Sbs317Append(trace, sizeof(trace), length, "null");
+  }
+  valid = valid && Sbs317Append(
+                       trace, sizeof(trace), length,
+                       ",\"color_rt_raw32\":[%u,%u,%u,%u],\"depth_rt_raw32\":%u,"
+                       "\"target_register_correlation_scope\":\"frame_and_raw_color_depth_registers_only\",\"render_target_path_raw\":%u,\"render_target_path_encoding\":\"backend_enum_raw\","
+                       "\"viewport\":[",
