+    read.Type = D3D12_HEAP_TYPE_READBACK;
+    desc.Width = PrivateDepthResolve::kLength;
+    hr = device->CreateCommittedResource(&read, D3D12_HEAP_FLAG_NONE, &desc,
+        D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&probe.consumer_readback));
+    if (FAILED(hr)) return nullptr;
