+#pragma once
+#include <cstdint>
+#include <istream>
+namespace rex::input::research {
+struct RecoveryAxes { int16_t x=0, y=0; };
+inline RecoveryAxes ReadRecoveryCommand(std::istream& command, int64_t now_ms) {
+  if (now_ms<0) return {};
+  int64_t expires=0, sequence=0; int x=0,y=0;
+  if (!(command >> expires >> sequence >> x >> y)) return {};
+  command >> std::ws;
+  if (!command.eof() || sequence<=0 || expires<=now_ms || expires-now_ms>500 ||
+      x < -32767 || x > 32767 || y < -32767 || y > 32767) return {};
+  return {int16_t(x),int16_t(y)};
+}
+}
