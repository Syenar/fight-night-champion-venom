--- /dev/null
+++ b/thirdparty/sdl3/src/SDL_venom_finalization.h
@@ -0,0 +1,113 @@
+/* Private Venom candidate addition; altered SDL source, not an upstream API.
+ * Included by SDL.c after SDL_internal.h. No native/controller lock is taken
+ * by the deferral path. All matching subsystem quits run on the SDL main thread.
+ */
+#ifndef REX_SDL_OUTPUT_FINALIZATION_H
+#define REX_SDL_OUTPUT_FINALIZATION_H
+
+static SDL_AtomicInt rex_output_leases;
+static SDL_AtomicInt rex_pending_global_quit;
+static SDL_AtomicInt rex_pending_subsystem_quits[32];
+static bool rex_flushing_quits;
+
+static void RexSDL_QueueMatchingQuit(SDL_InitFlags flags)
+{
+    unsigned bit;
+    for (bit = 0; bit < 32; ++bit) {
+        if (flags & ((SDL_InitFlags)1 << bit)) {
+            SDL_AddAtomicInt(&rex_pending_subsystem_quits[bit], 1);
+        }
+    }
+}
+
+bool RexSDL_AcquireOutputLease(void)
+{
+    if (!SDL_IsMainThread() || SDL_GetAtomicInt(&rex_pending_global_quit)) {
+        return false;
+    }
+    SDL_AddAtomicInt(&rex_output_leases, 1);
+    if (!SDL_InitSubSystem(SDL_INIT_EVENTS)) {
+        /* Init's own partial-success error path queued only its actual quits. */
+        SDL_AddAtomicInt(&rex_output_leases, -1);
+        return false;
+    }
+    return true;
+}
+
+bool RexSDL_CompleteOutputGamepadLease(void)
+{
+    return SDL_IsMainThread() && SDL_InitSubSystem(SDL_INIT_GAMEPAD);
+}
+
+void RexSDL_ReleaseOutputLease(SDL_InitFlags acquired_flags)
+{
+    /* Publication precedes the final decrement so a main-thread drain cannot
+       observe zero leases while missing this successful init's matching quits. */
+    RexSDL_QueueMatchingQuit(acquired_flags);
+    SDL_AddAtomicInt(&rex_output_leases, -1);
+}
+
+static void RexSDL_DeferProtectedQuit(SDL_InitFlags *flags)
+{
+    const SDL_InitFlags protected_flags = SDL_INIT_GAMEPAD | SDL_INIT_JOYSTICK | SDL_INIT_EVENTS;
+    if (SDL_GetAtomicInt(&rex_output_leases) > 0) {
+        const SDL_InitFlags deferred = *flags & protected_flags;
+        RexSDL_QueueMatchingQuit(deferred);
+        *flags &= ~protected_flags;
+    }
+}
+
+static bool RexSDL_DeferGlobalQuit(void)
+{
+    if (SDL_GetAtomicInt(&rex_output_leases) > 0) {
+        SDL_SetAtomicInt(&rex_pending_global_quit, 1);
+        return true;
+    }
+    return false;
+}
+
+static void RexSDL_DiscardDeferredForGlobalQuit(void)
+{
+    unsigned bit;
+    SDL_SetAtomicInt(&rex_pending_global_quit, 0);
+    for (bit = 0; bit < 32; ++bit) {
+        SDL_SetAtomicInt(&rex_pending_subsystem_quits[bit], 0);
+    }
+}
+
+/* True means a queued global quit completed; the caller's extra matching quit
+   is already subsumed by global finalization and must not decrement again. */
+static bool RexSDL_FlushDeferredOnMainThread(void)
+{
+    unsigned bit;
+    if (rex_flushing_quits || !SDL_IsMainThread() || SDL_GetAtomicInt(&rex_output_leases) > 0) {
+        return false;
+    }
+    rex_flushing_quits = true;
+    if (SDL_SetAtomicInt(&rex_pending_global_quit, 0)) {
+        RexSDL_DiscardDeferredForGlobalQuit();
+        SDL_Quit();
+        rex_flushing_quits = false;
+        return true;
+    }
+    for (bit = 0; bit < 32; ++bit) {
+        const int count = SDL_SetAtomicInt(&rex_pending_subsystem_quits[bit], 0);
+        int index;
+        for (index = 0; index < count; ++index) {
+            SDL_QuitSubSystem((SDL_InitFlags)1 << bit);
+        }
+    }
+    rex_flushing_quits = false;
+    return false;
+}
+
+void RexSDL_DrainOutputFinalization(void)
+{
+    (void)RexSDL_FlushDeferredOnMainThread();
+}
+
+int RexSDL_PendingOutputLeases(void)
+{
+    return SDL_GetAtomicInt(&rex_output_leases);
+}
+#endif
