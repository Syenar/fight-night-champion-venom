+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <memory>
+#include <mutex>
+#include <utility>
+#include <vector>
+
+namespace rex::input::sdl::detail {
+
+// The native watch registration owns this state independently of its driver.
+// Removal is performed only by the watch itself, while the native dispatcher
+// holds its recursive watch-list lock. No background native API call is made.
+// If no event arrives after deactivation, the inactive registration deliberately
+// retains its state. Subsystem/module finalization is a separate prerequisite.
+template <typename Event>
+class CallbackLifetimeState
+    : public std::enable_shared_from_this<CallbackLifetimeState<Event>> {
+ public:
+  void RetainForRegistration() {
+    // Call before registration, before the native dispatcher can see userdata.
+    registration_owner_ = this->shared_from_this();
+    std::lock_guard lock(removal_mutex_);
+    removed_ = false;
+  }
+
+  void CancelFailedRegistration() {
+    // Valid only when native registration failed and cannot dispatch callbacks.
+    registration_owner_.reset();
+    MarkRemoved();
+  }
+
+  void Deactivate() { active_.store(false, std::memory_order_release); }
+  bool IsActive() const { return active_.load(std::memory_order_acquire); }
+
+  template <typename BeforeBuffer, typename RemoveWatch>
+  void Dispatch(const Event& event, bool relevant, BeforeBuffer before_buffer,
+                RemoveWatch remove_watch) {
+    // Removal is reentrant, so native removal is not itself a quiescence fence
+    // for this stack frame. Keep a local owner until Dispatch has returned.
+    auto callback_owner = this->shared_from_this();
+    if (relevant && IsActive()) {
+      // Native event APIs may reenter. Never invoke them with pending_mutex_.
+      before_buffer();
+      std::lock_guard lock(pending_mutex_);
+      if (IsActive()) {
+        pending_.push_back(event);
+      }
+    }
+
+    if (!IsActive()) {
+      TryRetireRegistration(remove_watch);
+    }
+  }
+
+  template <typename RemoveWatch>
+  void RetireRegistration(RemoveWatch remove_watch) {
+    auto callback_owner = this->shared_from_this();
+    Deactivate();
+    if (!TryRetireRegistration(remove_watch)) {
+      // Only independent retirement workers wait. A native callback never waits
+      // for a remover that may itself be waiting for the watch-list lock.
+      std::unique_lock lock(removal_mutex_);
+      removal_changed_.wait(lock, [this] { return removed_; });
+    }
+  }
+
+  std::vector<Event> TakePending() {
+    std::vector<Event> result;
+    std::lock_guard lock(pending_mutex_);
+    result.swap(pending_);
+    return result;
+  }
+
+  size_t PendingCount() const {
+    std::lock_guard lock(pending_mutex_);
+    return pending_.size();
+  }
+
+  bool TryQueuePump() {
+    if (!IsActive()) {
+      return false;
+    }
+    bool expected = false;
+    return pump_queued_.compare_exchange_strong(expected, true);
+  }
+
+  void CancelQueuedPump() { pump_queued_.store(false, std::memory_order_release); }
+  bool PumpQueued() const { return pump_queued_.load(std::memory_order_acquire); }
+
+  template <typename Pump>
+  void RunQueuedPump(Pump pump) {
+    try {
+      if (IsActive()) {
+        pump();
+      }
+    } catch (...) {
+      CancelQueuedPump();
+      throw;
+    }
+    CancelQueuedPump();
+  }
+
+  bool WaitForRemoval(std::chrono::milliseconds budget) {
+    std::unique_lock lock(removal_mutex_);
+    return removal_changed_.wait_for(lock, budget, [this] { return removed_; });
+  }
+
+ private:
+  template <typename RemoveWatch>
+  bool TryRetireRegistration(RemoveWatch remove_watch) {
+    bool expected = false;
+    if (!retirement_started_.compare_exchange_strong(expected, true)) {
+      return false;
+    }
+    try {
+      remove_watch();
+    } catch (...) {
+      retirement_started_.store(false, std::memory_order_release);
+      throw;
+    }
+    registration_owner_.reset();
+    MarkRemoved();
+    return true;
+  }
+
+  void MarkRemoved() {
+    {
+      std::lock_guard lock(removal_mutex_);
+      removed_ = true;
+    }
+    removal_changed_.notify_all();
+  }
+
+  std::atomic<bool> active_{true};
+  std::atomic<bool> pump_queued_{false};
+  std::atomic<bool> retirement_started_{false};
+  mutable std::mutex pending_mutex_;
+  std::vector<Event> pending_;
+  std::shared_ptr<CallbackLifetimeState> registration_owner_;
+  std::mutex removal_mutex_;
+  std::condition_variable removal_changed_;
+  bool removed_ = true;
+};
+
+}  // namespace rex::input::sdl::detail
