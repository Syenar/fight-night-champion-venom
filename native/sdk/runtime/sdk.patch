+// Exact TU2 GameStateAdapter getter delegates to byte 440 at this object + 4.
+uint32_t VenomReadBareMode(uint8_t* base) {
+  uint32_t word = 0;
+  std::memcpy(&word, base + 0x82FE1E30, sizeof(word));
+  const uint32_t object = __builtin_bswap32(word);
+  uint8_t flag = 0;
+  SIZE_T bytes = 0;
+  if (!object ||
+      !ReadProcessMemory(GetCurrentProcess(), base + uint32_t(object + 444), &flag, 1, &bytes) ||
+      bytes != 1) return 256;
+  return flag;
+}
+
+void VenomEnterBareMode(PPCContext& ctx, uint8_t* base) {
+  const uint32_t before = VenomReadBareMode(base);
+  const uint32_t caller = uint32_t(ctx.lr);
+  original_enter_bare(ctx, base);
+  REXSYS_INFO("VENOM_BARE_ENTER lr={:08X} flag {} -> {}", caller, before, VenomReadBareMode(base));
