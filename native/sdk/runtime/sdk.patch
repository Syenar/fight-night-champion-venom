+// Read a whole sidecar before exposing metadata or license bits. Marketplace
+// records must include the stored mask even when it is zero; never invent bits.
+static X_RESULT ReadCheckedHeader(const std::filesystem::path& path,
+                                  XCONTENT_AGGREGATE_DATA& data, uint32_t& mask) {
+  data = {};
+  mask = 0;
+  dlc_io::LockedDirectories header_parents;
+  auto* file = dlc_io::OpenFileChecked(path, false, header_parents);
+  if (!file) return X_ERROR_FILE_NOT_FOUND;
+  XCONTENT_AGGREGATE_DATA candidate{};
+  uint32_t stored_mask = 0;
+  const size_t metadata_read = fread(&candidate, 1, sizeof(candidate), file);
+  const size_t mask_read = fread(&stored_mask, 1, sizeof(stored_mask), file);
+  const int trailing = fgetc(file);
+  const bool read_failed = ferror(file) != 0;
+  const bool close_failed = fclose(file) != 0;
+  if (metadata_read != sizeof(candidate) || read_failed || close_failed) {
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  if (candidate.content_type == XContentType::kMarketplaceContent &&
+      (mask_read != sizeof(stored_mask) || trailing != EOF ||
+       uint64_t(candidate.xuid) != 0 ||
+       !std::all_of(std::begin(candidate.file_name_raw), std::end(candidate.file_name_raw),
+                    [](unsigned char ch) { return std::isxdigit(ch) != 0; }) ||
+       candidate.padding[0] != 0 || candidate.padding[1] != 0 ||
+       std::none_of(std::begin(candidate.display_name_raw.uint),
+                    std::end(candidate.display_name_raw.uint),
+                    [](uint16_t ch) { return ch == 0; }))) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+  data = candidate;
+  // Non-marketplace records historically may omit the mask.
+  if (mask_read == sizeof(stored_mask)) mask = stored_mask;
+  return X_ERROR_SUCCESS;
+}
