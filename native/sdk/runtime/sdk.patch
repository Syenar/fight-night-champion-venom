+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <utility>
+
+namespace rex::ui {
+
+using GuestInputActivitySnapshot = std::shared_ptr<std::atomic<uint32_t>>;
+constexpr uint32_t kGuestInputCapturePolicy = 1;
+constexpr uint32_t kGuestInputMouseCapture = 2;
+constexpr uint32_t kGuestInputStopped = 4;
+
+inline GuestInputActivitySnapshot CreateGuestInputActivitySnapshot() {
+  return std::make_shared<std::atomic<uint32_t>>(0);
+}
+
+inline void SetGuestInputCapturePolicy(const GuestInputActivitySnapshot& snapshot,
+                                       bool enabled) {
+  if (enabled) {
+    snapshot->fetch_or(kGuestInputCapturePolicy, std::memory_order_release);
+  } else {
+    snapshot->fetch_and(~kGuestInputCapturePolicy, std::memory_order_release);
+  }
+}
+
+inline void PublishGuestInputMouseCapture(const GuestInputActivitySnapshot& snapshot,
+                                          bool captured) {
+  if (captured) {
+    snapshot->fetch_or(kGuestInputMouseCapture, std::memory_order_release);
+  } else {
+    snapshot->fetch_and(~kGuestInputMouseCapture, std::memory_order_release);
+  }
+}
+
+inline void StopGuestInputActivity(const GuestInputActivitySnapshot& snapshot) {
+  snapshot->fetch_or(kGuestInputStopped, std::memory_order_release);
+}
+
+inline std::function<bool()> MakeGuestInputActiveCallback(
+    const GuestInputActivitySnapshot& snapshot) {
+  std::shared_ptr<const std::atomic<uint32_t>> read_only_snapshot = snapshot;
+  return [snapshot = std::move(read_only_snapshot)]() noexcept {
+    if (!snapshot) {
+      return false;
+    }
+    const uint32_t flags = snapshot->load(std::memory_order_acquire);
+    return !(flags & kGuestInputStopped) &&
+           (flags & (kGuestInputCapturePolicy | kGuestInputMouseCapture)) !=
+               (kGuestInputCapturePolicy | kGuestInputMouseCapture);
+  };
+}
+
+}  // namespace rex::ui
