+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace rex::input::output::detail {
+
+enum class StopResult : uint32_t {
+  Waiting,
+  NoOutstandingWrite,
+  ZeroSucceeded,
+  ZeroFailed,
+  Disconnected,
+  SetupFailedRetained
+};
+
+struct NativeBinding {
+  // Captures must own the native endpoint/provider and their implementation code.
+  std::function<uint32_t(uint16_t, uint16_t)> write;
+  std::function<bool()> connected;
+  std::function<void()> close;
+  std::shared_ptr<void> lifetime;
+  uint32_t endpoint_kind = 0;
+  uint32_t endpoint_index = 0;
+};
+
+struct Admission {
+  static constexpr uint64_t kClosed = uint64_t{1} << 63;
+  std::atomic<uint64_t> registrations{0};
+  std::atomic<uint32_t> retained{0};
+  bool Open() const noexcept { return !(registrations.load(std::memory_order_acquire) & kClosed); }
+  // A sequence change cannot be lost between the predicate check and wait.
+  // Closing callers never acquire a controller, writer or notification mutex.
+  std::atomic<uint64_t> wake_sequence{0};
+
+  void NotifyRetirement() noexcept {
+    wake_sequence.fetch_add(1, std::memory_order_release);
+    wake_sequence.notify_all();
+  }
+  std::mutex completion_mutex;
+  std::condition_variable completion;
+  std::atomic<uint32_t> pending{0};
+};
+
+struct EndpointSnapshot {
+  uint64_t identity;
+  uint32_t endpoint_kind;
+  uint32_t endpoint_index;
+  uint64_t successful_nonzero;
+  uint64_t successful_zero;
+  uint64_t failed_writes;
+  uint64_t rejected_writes;
+  bool outstanding;
+  bool native_references_closed;
+  bool worker_finished;
+  bool retained;
+  StopResult stop_result;
+};
+
+class Endpoint : public std::enable_shared_from_this<Endpoint> {
+ public:
+  Endpoint(std::shared_ptr<Admission> admission, uint64_t identity, NativeBinding binding)
+      : admission_(std::move(admission)), identity_(identity),
+        endpoint_kind_(binding.endpoint_kind), endpoint_index_(binding.endpoint_index),
+        native_(std::move(binding)) {}
+
+  uint32_t Write(uint16_t low, uint16_t high) {
+    if (!admission_->Open() ||
+        retire_.load(std::memory_order_acquire)) {
+      rejected_writes_.fetch_add(1, std::memory_order_relaxed);
+      return 1627;  // X_ERROR_FUNCTION_FAILED; no physical output was admitted.
+    }
+    std::lock_guard lock(writer_);
+    // An earlier caller may have waited behind an in-flight native operation.
+    if (!admission_->Open() ||
+        retire_.load(std::memory_order_acquire)) {
+      rejected_writes_.fetch_add(1, std::memory_order_relaxed);
+      return 1627;
+    }
+    const uint32_t result = native_.write(low, high);
+    RecordReturnedWrite(result, low, high);
+    return result;
+  }
+
+  void Retire(bool disconnected) noexcept {
+    if (disconnected) {
+      disconnected_.store(true, std::memory_order_release);
+    }
+    retire_.store(true, std::memory_order_release);
+    admission_->NotifyRetirement();
+  }
+
+  EndpointSnapshot Snapshot() const noexcept {
+    // Acquire completion FIRST: a true finished flag makes the subsequent
+    // final counters/result coherent. Pending rows are explicitly observations.
+    const bool finished = worker_finished_.load(std::memory_order_acquire);
+    return {identity_, endpoint_kind_, endpoint_index_, successful_nonzero_.load(),
+            successful_zero_.load(), failed_writes_.load(), rejected_writes_.load(),
+            outstanding_.load(), native_references_closed_.load(), finished,
+            retained_after_exception_.load(), stop_result_.load()};
+  }
+
+  bool Finished() const noexcept { return worker_finished_.load(std::memory_order_acquire); }
+  bool Retained() const noexcept { return retained_after_exception_.load(std::memory_order_acquire); }
+
+  void RunOwnedRetirement() noexcept {
+    for (;;) {
+      const uint64_t sequence = admission_->wake_sequence.load(std::memory_order_acquire);
+      if (!admission_->Open() || retire_.load(std::memory_order_acquire)) {
+        break;
+      }
+      // A close/retire after the check changes sequence before notification.
+      // wait(old) then returns even if the notification preceded registration.
+      admission_->wake_sequence.wait(sequence, std::memory_order_acquire);
+    }
+    try {
+      // Never owned by the UI close caller. It serializes after admitted writes.
+      std::lock_guard lock(writer_);
+      if (disconnected_.load(std::memory_order_acquire)) {
+        stop_result_.store(StopResult::Disconnected, std::memory_order_release);
+      } else if (!outstanding_.load(std::memory_order_acquire)) {
+        stop_result_.store(StopResult::NoOutstandingWrite, std::memory_order_release);
+      } else if (!native_.connected() || disconnected_.load(std::memory_order_acquire)) {
+        disconnected_.store(true, std::memory_order_release);
+        stop_result_.store(StopResult::Disconnected, std::memory_order_release);
+      } else {
+        const uint32_t result = native_.write(0, 0);
+        RecordReturnedWrite(result, 0, 0);
+        stop_result_.store(result == 0 ? StopResult::ZeroSucceeded : StopResult::ZeroFailed,
+                           std::memory_order_release);
+      }
+      // A disconnected outstanding SDL handle can emit an implicit stop during
+      // final native close. Quarantine it instead of risking a replacement slot.
+      if (stop_result_.load(std::memory_order_acquire) == StopResult::Disconnected &&
+          outstanding_.load(std::memory_order_acquire)) {
+        retained_after_exception_.store(true, std::memory_order_release);
+        admission_->retained.fetch_add(1, std::memory_order_relaxed);
+      } else {
+        // Close may also stall. Captured state/providers/leases stay owned.
+        native_.close();
+        native_references_closed_.store(true, std::memory_order_release);
+        native_.write = {};
+        native_.connected = {};
+        native_.close = {};
+        native_.lifetime.reset();
+      }
+    } catch (...) {
+      // Retain the binding on an exceptional native boundary; never invent zero.
+      stop_result_.store(StopResult::SetupFailedRetained, std::memory_order_release);
+      retained_after_exception_.store(true, std::memory_order_release);
+      admission_->retained.fetch_add(1, std::memory_order_relaxed);
+    }
+    worker_finished_.store(true, std::memory_order_release);
+    admission_->pending.fetch_sub(1, std::memory_order_acq_rel);
+    admission_->completion.notify_all();
+  }
+
+  void MarkWorkerSetupFailed() noexcept {
+    retire_.store(true, std::memory_order_release);
+    stop_result_.store(StopResult::SetupFailedRetained, std::memory_order_release);
+    retained_after_exception_.store(true, std::memory_order_release);
+    admission_->retained.fetch_add(1, std::memory_order_relaxed);
+    // No worker exists to release its binding; registry retains it indefinitely.
+  }
+
+ private:
+  void RecordReturnedWrite(uint32_t result, uint16_t low, uint16_t high) noexcept {
+    if (result != 0) {
+      failed_writes_.fetch_add(1, std::memory_order_relaxed);
+      return;
+    }
+    const bool nonzero = low != 0 || high != 0;
+    if (nonzero) {
+      successful_nonzero_.fetch_add(1, std::memory_order_relaxed);
+    } else {
+      successful_zero_.fetch_add(1, std::memory_order_relaxed);
+    }
+    outstanding_.store(nonzero, std::memory_order_release);
+  }
+
+  std::shared_ptr<Admission> admission_;
+  const uint64_t identity_;
+  const uint32_t endpoint_kind_;
+  const uint32_t endpoint_index_;
+  NativeBinding native_;
+  std::mutex writer_;
+  std::atomic<bool> retire_{false};
+  std::atomic<bool> disconnected_{false};
+  std::atomic<bool> outstanding_{false};
+  std::atomic<bool> native_references_closed_{false};
+  std::atomic<bool> worker_finished_{false};
+  std::atomic<bool> retained_after_exception_{false};
+  std::atomic<uint64_t> successful_nonzero_{0};
+  std::atomic<uint64_t> successful_zero_{0};
+  std::atomic<uint64_t> failed_writes_{0};
+  std::atomic<uint64_t> rejected_writes_{0};
+  std::atomic<StopResult> stop_result_{StopResult::Waiting};
+};
+
+class Coordinator {
+ public:
+  Coordinator() : admission_(std::make_shared<Admission>()) {}
+  Coordinator(const Coordinator&) = delete;
+  Coordinator& operator=(const Coordinator&) = delete;
+
+  class Registration {
+   public:
+    explicit Registration(std::shared_ptr<Admission> admission) : admission_(std::move(admission)) {}
+    Registration(const Registration&) = delete;
+    Registration& operator=(const Registration&) = delete;
+    ~Registration() {
+      admission_->registrations.fetch_sub(1, std::memory_order_acq_rel);
+      admission_->completion.notify_all();
+    }
+   private:
+    std::shared_ptr<Admission> admission_;
+  };
+
+  std::shared_ptr<Registration> BeginNativeRegistration() {
+    uint64_t value = admission_->registrations.load(std::memory_order_acquire);
+    for (;;) {
+      if (value & Admission::kClosed) {
+        return {};
+      }
+      if (admission_->registrations.compare_exchange_weak(value, value + 1,
+                                                         std::memory_order_acq_rel)) {
+        try {
+          return std::make_shared<Registration>(admission_);
+        } catch (...) {
+          admission_->registrations.fetch_sub(1, std::memory_order_acq_rel);
+          admission_->completion.notify_all();
+          throw;
+        }
+      }
+    }
+  }
+
+  std::shared_ptr<Endpoint> Register(NativeBinding binding, const std::shared_ptr<Registration>& registration) {
+    // Acquire the registration ticket BEFORE opening/retaining any native resource.
+    // Closing the high bit prevents all later tickets without a UI registry lock.
+    if (!registration) {
+      return {};
+    }
+    auto endpoint = std::make_shared<Endpoint>(admission_, next_identity_.fetch_add(1),
+                                               std::move(binding));
+    auto record = std::make_unique<Record>();
+    record->endpoint = endpoint;
+    auto job = std::make_shared<Job>();
+    job->endpoint = endpoint;
+    {
+      std::lock_guard lock(registry_mutex_);
+      jobs_.push_back(job);
+      admission_->pending.fetch_add(1, std::memory_order_acq_rel);
+    }
+    auto* published_record = record.release();
+    published_record->next = records_.load(std::memory_order_acquire);
+    while (!records_.compare_exchange_weak(published_record->next, published_record,
+                                           std::memory_order_acq_rel)) {}
+    try {
+      job->thread = std::thread([endpoint] { endpoint->RunOwnedRetirement(); });
+    } catch (...) {
+      endpoint->MarkWorkerSetupFailed();
+      // Pending intentionally stays nonzero: bounded close reports incomplete.
+    }
+    job->published.store(true, std::memory_order_release);
+    return endpoint;
+  }
+
+  bool Open() const noexcept { return admission_->Open(); }
+
+  void CloseAdmission() noexcept {
+    // No registry/controller/writer/native lock, allocation, open, close or quit.
+    admission_->registrations.fetch_or(Admission::kClosed, std::memory_order_acq_rel);
+    admission_->NotifyRetirement();
+  }
+
+  bool WaitForRetirement(std::chrono::milliseconds budget) {
+    std::unique_lock lock(admission_->completion_mutex);
+    return admission_->completion.wait_for(lock, budget, [this] {
+      return admission_->pending.load(std::memory_order_acquire) == 0 &&
+             (admission_->registrations.load(std::memory_order_acquire) & ~Admission::kClosed) == 0;
+    });
+  }
+
+  void CollectFinishedOutsideUI() {
+    std::vector<std::shared_ptr<Job>> finished;
+    {
+      std::lock_guard lock(registry_mutex_);
+      for (auto iterator = jobs_.begin(); iterator != jobs_.end();) {
+        if ((*iterator)->published.load(std::memory_order_acquire) &&
+            (*iterator)->endpoint->Finished() && !(*iterator)->endpoint->Retained()) {
+          finished.push_back(*iterator);
+          iterator = jobs_.erase(iterator);
+        } else {
+          ++iterator;
+        }
+      }
+    }
+    for (auto& job : finished) {
+      if (job->thread.joinable()) {
+        job->thread.join();
+      }
+    }
+  }
+
+  template <typename Observe>
+  void ObserveRecords(Observe observe) const {
+    // Records are immutable process-lifetime owners; no UI/controller/native lock.
+    for (auto* record = records_.load(std::memory_order_acquire); record; record = record->next) {
+      observe(record->endpoint->Snapshot());
+    }
+  }
+
+  uint64_t PendingRegistrations() const noexcept {
+    return admission_->registrations.load(std::memory_order_acquire) & ~Admission::kClosed;
+  }
+
+  uint32_t Retained() const noexcept { return admission_->retained.load(std::memory_order_acquire); }
+
+  uint32_t Pending() const noexcept { return admission_->pending.load(std::memory_order_acquire); }
+
+ private:
+  struct Record {
+    std::shared_ptr<Endpoint> endpoint;
+    Record* next = nullptr;
+  };
+  struct Job {
+    std::shared_ptr<Endpoint> endpoint;
+    std::thread thread;
+    std::atomic<bool> published{false};
+  };
+  // Production owns this coordinator for process lifetime in a pinned module.
+  // Tests must close, unblock fake boundaries, wait and collect before destruction.
+  std::shared_ptr<Admission> admission_;
+  std::atomic<uint64_t> next_identity_{1};
+  std::mutex registry_mutex_;
+  std::vector<std::shared_ptr<Job>> jobs_;
+  std::atomic<Record*> records_{nullptr};
+};
+
+}  // namespace rex::input::output::detail
