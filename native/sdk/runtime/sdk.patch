+  const auto add = [&](uint16_t key) {
+    keys.emplace(key, SyntheticKey(key, rex::input::X_INPUT_KEYSTROKE_KEYDOWN, slot));
+  };
+  static constexpr std::array<std::pair<uint16_t, uint16_t>, 14> buttons{{
+      {XINPUT_GAMEPAD_DPAD_UP, VK_PAD_DPAD_UP},
+      {XINPUT_GAMEPAD_DPAD_DOWN, VK_PAD_DPAD_DOWN},
+      {XINPUT_GAMEPAD_DPAD_LEFT, VK_PAD_DPAD_LEFT},
+      {XINPUT_GAMEPAD_DPAD_RIGHT, VK_PAD_DPAD_RIGHT},
+      {XINPUT_GAMEPAD_START, VK_PAD_START},
+      {XINPUT_GAMEPAD_BACK, VK_PAD_BACK},
+      {XINPUT_GAMEPAD_LEFT_THUMB, VK_PAD_LTHUMB_PRESS},
+      {XINPUT_GAMEPAD_RIGHT_THUMB, VK_PAD_RTHUMB_PRESS},
+      {XINPUT_GAMEPAD_LEFT_SHOULDER, VK_PAD_LSHOULDER},
+      {XINPUT_GAMEPAD_RIGHT_SHOULDER, VK_PAD_RSHOULDER},
+      {XINPUT_GAMEPAD_A, VK_PAD_A},
+      {XINPUT_GAMEPAD_B, VK_PAD_B},
+      {XINPUT_GAMEPAD_X, VK_PAD_X},
+      {XINPUT_GAMEPAD_Y, VK_PAD_Y},
+  }};
+  for (const auto& [mask, key] : buttons) {
+    if (gamepad.wButtons & mask) {
+      add(key);
+    }
+  }
+  // Recovery follows the existing SDL virtual-key thresholds, not a new focus policy.
+  constexpr int16_t kThumbThreshold = 0x4E00;
+  constexpr uint8_t kTriggerThreshold = 0x1F;
+  if (gamepad.bLeftTrigger > kTriggerThreshold) {
+    add(VK_PAD_LTRIGGER);
+  }
+  if (gamepad.bRightTrigger > kTriggerThreshold) {
+    add(VK_PAD_RTRIGGER);
+  }
+  const auto add_thumb = [&](int16_t x, int16_t y, uint16_t first_key) {
+    const bool up = y > kThumbThreshold;
+    const bool down = y < ~kThumbThreshold;
+    const bool right = x > kThumbThreshold;
+    const bool left = x < ~kThumbThreshold;
+    if (up && left) {
+      add(first_key + 4);
+    } else if (up && right) {
+      add(first_key + 5);
+    } else if (down && right) {
+      add(first_key + 6);
+    } else if (down && left) {
+      add(first_key + 7);
+    } else if (up) {
+      add(first_key);
+    } else if (down) {
+      add(first_key + 1);
+    } else if (right) {
+      add(first_key + 2);
+    } else if (left) {
+      add(first_key + 3);
+    }
+  };
+  add_thumb(gamepad.sThumbLX, gamepad.sThumbLY, VK_PAD_LTHUMB_UP);
+  add_thumb(gamepad.sThumbRX, gamepad.sThumbRY, VK_PAD_RTHUMB_UP);
+  return keys;
+}
