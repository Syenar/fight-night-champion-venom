+// Private normal-close candidate. Native ownership is retained through the
+// existing process hard-exit policy; this is not clean subsystem finalization.
+#include <rex/input/output_lifetime.h>
+#include <rex/logging.h>
+
+#include <new>
+#include <stdexcept>
+
+#include <windows.h>
+#include <xinput.h>
+#include <SDL3/SDL.h>
+
+extern "C" bool RexSDL_AcquireOutputLease(void);
+extern "C" bool RexSDL_CompleteOutputGamepadLease(void);
+extern "C" int RexSDL_PendingOutputLeases(void);
+extern "C" void RexSDL_ReleaseOutputLease(SDL_InitFlags flags);
+
+namespace rex::input::output {
+namespace {
+
+std::once_flag initialize_once;
+std::atomic<detail::Coordinator*> coordinator{nullptr};
+std::atomic<uint32_t> retained_setup_failures{0};
+
+// Intrusive process-lifetime quarantine. Publish only preallocated ownership;
+// close never discovers, allocates, locks this list, or releases its resources.
+struct QuarantineNode {
+  Lease owner;
+  QuarantineNode* next = nullptr;
+};
+std::atomic<QuarantineNode*> quarantine{nullptr};
+
+void PublishQuarantine(QuarantineNode* node) noexcept {
+  node->next = quarantine.load(std::memory_order_acquire);
+  while (!quarantine.compare_exchange_weak(node->next, node, std::memory_order_acq_rel)) {}
+}
+
+struct SdlAttachmentLease {
+  bool acquired = false;
+  std::atomic<uint32_t> flags{SDL_INIT_EVENTS};
+  ~SdlAttachmentLease() {
+    if (acquired) {
+      RexSDL_ReleaseOutputLease(flags.load(std::memory_order_acquire));
+    }
+  }
+};
+struct SdlReference {
+  Lease lease;
+  SDL_Gamepad* handle = nullptr;
+  // No automatic native close: original references and failed setup acquisitions
+  // must never call SDL/driver output from a UI destructor or unowned timeout.
+};
+
+void RetainSetupFailure() noexcept {
+  retained_setup_failures.fetch_add(1, std::memory_order_relaxed);
+}
+
+detail::Coordinator* GetCoordinator() noexcept {
+  return coordinator.load(std::memory_order_acquire);
+}
+
+}  // namespace
+
+struct XinputProvider {
+  using SetState = DWORD(WINAPI*)(DWORD, XINPUT_VIBRATION*);
+  using GetState = DWORD(WINAPI*)(DWORD, XINPUT_STATE*);
+  SetState set_state = nullptr;
+  GetState get_state = nullptr;
+  HMODULE original_module = nullptr;
+  HMODULE set_module = nullptr;
+  HMODULE get_module = nullptr;
+  // Owned references are quarantined for process lifetime, including partial
+  // acquisition failure. They are never FreeLibrary'd by a worker/UI destructor.
+};
+
+bool InitializeOwnership() {
+  std::call_once(initialize_once, [] {
+    // The worker, SDL implementation (static), leases and callbacks live here.
+    // PIN avoids ever releasing the last implementation reference from its own
+    // destructor or returning into an unloaded module. Deliberately process-wide.
+    HMODULE implementation = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                           reinterpret_cast<LPCWSTR>(&InitializeOwnership), &implementation)) {
+      return;
+    }
+    try {
+      auto* owned = new detail::Coordinator();
+      coordinator.store(owned, std::memory_order_release);
+    } catch (...) {
+      RetainSetupFailure();
+    }
+  });
+  return GetCoordinator() != nullptr;
+}
+
+bool OwnershipConfigured() noexcept { return GetCoordinator() != nullptr; }
+bool AdmissionOpen() noexcept {
+  auto* owner = GetCoordinator();
+  return owner && owner->Open();
+}
+void CloseAdmission() noexcept {
+  if (auto* owner = GetCoordinator()) {
+    owner->CloseAdmission();
+  }
+}
+CloseObservation WaitForRetirement(uint32_t milliseconds) {
+  if (auto* owner = GetCoordinator()) {
+    const bool finished = owner->WaitForRetirement(std::chrono::milliseconds(milliseconds));
+    return {finished, owner->Pending(), owner->PendingRegistrations(),
+            owner->Retained() + retained_setup_failures.load(),
+            static_cast<uint32_t>(RexSDL_PendingOutputLeases())};
+  }
+  return {true, 0, 0, retained_setup_failures.load(),
+          static_cast<uint32_t>(RexSDL_PendingOutputLeases())};
+}
+void CollectFinishedOutsideUI() {
+  if (auto* owner = GetCoordinator()) {
+    owner->CollectFinishedOutsideUI();
+  }
+}
+void LogRetirementRecords() {
+  if (auto* owner = GetCoordinator()) {
+    owner->ObserveRecords([](const detail::EndpointSnapshot& record) {
+      REXLOG_INFO("Controller output record: endpoint={}, kind={}, native_index={}, nonzero_ok={}, zero_ok={}, failed={}, rejected={}, outstanding={}, refs_closed={}, worker_finished={}, retained={}, stop_result={}",
+                  record.identity, record.endpoint_kind, record.endpoint_index,
+                  record.successful_nonzero, record.successful_zero, record.failed_writes,
+                  record.rejected_writes, record.outstanding, record.native_references_closed,
+                  record.worker_finished, record.retained, static_cast<uint32_t>(record.stop_result));
+    });
+  }
+}
+
+Registration BeginNativeRegistration() {
+  if (auto* owner = GetCoordinator()) {
+    return owner->BeginNativeRegistration();
+  }
+  return {};
+}
+
+Lease AcquireSDLAttachmentLease() {
+  auto registration = BeginNativeRegistration();
+  if (!registration) {
+    return {};
+  }
+  auto lease = std::make_shared<SdlAttachmentLease>();
+  // EVENTS owns the watch before GAMEPAD initialization emits initial adds.
+  if (!RexSDL_AcquireOutputLease()) {
+    return {};
+  }
+  lease->acquired = true;
+  return lease;
+}
+
+bool CompleteSDLGamepadLease(const Lease& lease) {
+  auto registration = BeginNativeRegistration();
+  if (!registration || !lease) {
+    return false;
+  }
+  if (!RexSDL_CompleteOutputGamepadLease()) {
+    return false;
+  }
+  auto owned = std::static_pointer_cast<SdlAttachmentLease>(lease);
+  owned->flags.fetch_or(SDL_INIT_GAMEPAD, std::memory_order_release);
+  return true;
+}
+
+SdlDevice OpenSDLDevice(uint32_t instance, const Lease& lease) {
+  auto registration = BeginNativeRegistration();
+  if (!registration || !lease.use_count()) {
+    return {};
+  }
+  // Preallocate the process owner before opening the original input reference.
+  auto original = std::make_shared<SdlReference>();
+  original->lease = lease;
+  auto original_node = std::make_unique<QuarantineNode>();
+  original_node->owner = original;
+  original->handle = SDL_OpenGamepad(instance);
+  if (!original->handle) {
+    return {};
+  }
+  PublishQuarantine(original_node.release());
+  SdlDevice result{original->handle, {}};
+  if (!AdmissionOpen()) {
+    RetainSetupFailure();
+    return result;  // Original in-flight acquisition remains owned; no second open.
+  }
+
+  try {
+    auto independent = std::make_shared<SdlReference>();
+    independent->lease = lease;
+    auto independent_node = std::make_unique<QuarantineNode>();
+    independent_node->owner = independent;
+    independent->handle = SDL_OpenGamepad(instance);
+    if (!independent->handle) {
+      RetainSetupFailure();
+      return result;  // Input may exist; no borrowed output fallback.
+    }
+    PublishQuarantine(independent_node.release());
+    detail::NativeBinding binding;
+    binding.lifetime = independent;
+    binding.endpoint_kind = 1;
+    binding.endpoint_index = instance;
+    binding.write = [independent](uint16_t low, uint16_t high) {
+      return SDL_RumbleGamepad(independent->handle, low, high, low || high ? 0xFFFF : 0)
+                 ? uint32_t{0} : uint32_t{1627};
+    };
+    binding.connected = [independent] { return SDL_GamepadConnected(independent->handle); };
+    binding.close = [independent] {
+      // Only the independently acquired second reference. The input reference
+      // remains quarantined because TerminateTitle does not join all pollers.
+      SDL_CloseGamepad(independent->handle);
+      independent->handle = nullptr;
+    };
+    result.endpoint = GetCoordinator()->Register(std::move(binding), registration);
+  } catch (...) {
+    RetainSetupFailure();
+  }
+  return result;
+}
+
+EndpointRef RegisterContextRetirement(std::function<void()> retire, const Lease& lifetime,
+                                      const Registration& registration) {
+  if (!registration) {
+    RetainSetupFailure();
+    return {};
+  }
+  try {
+    detail::NativeBinding binding;
+    binding.lifetime = lifetime;
+    binding.endpoint_kind = 3;
+    binding.write = [](uint16_t, uint16_t) { return uint32_t{1627}; };
+    binding.connected = [] { return false; };
+    binding.close = std::move(retire);
+    return GetCoordinator()->Register(std::move(binding), registration);
+  } catch (...) {
+    RetainSetupFailure();
+    return {};
+  }
+}
+
+XinputProviderRef AcquireXinputProvider(void* original_module, void* set_state, void* get_state) {
+  auto registration = BeginNativeRegistration();
+  if (!registration || !set_state || !get_state) {
+    return {};
+  }
+  auto provider = std::make_shared<XinputProvider>();
+  auto node = std::make_unique<QuarantineNode>();
+  node->owner = provider;
+  provider->original_module = static_cast<HMODULE>(original_module);
+  PublishQuarantine(node.release());
+  // The original setup reference is transferred before additional acquisition.
+  // Once the first provider reference exists, even partial failures are retained.
+  if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+                         reinterpret_cast<LPCWSTR>(set_state), &provider->set_module)) {
+    return {};
+  }
+  if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+                         reinterpret_cast<LPCWSTR>(get_state), &provider->get_module)) {
+    RetainSetupFailure();
+    return {};
+  }
+  provider->set_state = reinterpret_cast<XinputProvider::SetState>(set_state);
+  provider->get_state = reinterpret_cast<XinputProvider::GetState>(get_state);
+  return provider;
+}
+
+EndpointRef OpenXinputEndpoint(const XinputProviderRef& provider, uint32_t slot) {
+  auto registration = BeginNativeRegistration();
+  if (!registration || !provider || slot >= 4) {
+    return {};
+  }
+  detail::NativeBinding binding;
+  binding.lifetime = provider;
+  binding.endpoint_kind = 2;
+  binding.endpoint_index = slot;
+  binding.write = [provider, slot](uint16_t low, uint16_t high) {
+    XINPUT_VIBRATION vibration{low, high};
+    return provider->set_state(slot, &vibration);
+  };
+  binding.connected = [provider, slot] {
+    XINPUT_STATE state{};
+    return provider->get_state(slot, &state) == ERROR_SUCCESS;
+  };
+  binding.close = [] {};
+  try {
+    return GetCoordinator()->Register(std::move(binding), registration);
+  } catch (...) {
+    RetainSetupFailure();
+    return {};
+  }
+}
+
+}  // namespace rex::input::output
