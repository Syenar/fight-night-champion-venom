+
+std::mutex activity_registry_mutex;
+std::map<const XinputInputDriver*, std::shared_ptr<DriverActivity>> activity_registry;
+
+std::shared_ptr<DriverActivity> ActivityForDriver(const XinputInputDriver* driver) {
+  std::lock_guard<std::mutex> lock(activity_registry_mutex);
+  auto& state = activity_registry[driver];
+  if (!state) {
+    state = std::make_shared<DriverActivity>();
+  }
+  return state;
+}
+
+void ForgetActivity(const XinputInputDriver* driver) {
+  std::lock_guard<std::mutex> lock(activity_registry_mutex);
+  activity_registry.erase(driver);
+}
+
+X_INPUT_KEYSTROKE SyntheticKey(uint16_t key, uint16_t flags, uint32_t slot) {
+  X_INPUT_KEYSTROKE result{};
+  result.virtual_key = key;
+  result.flags = flags;
+  result.user_index = static_cast<uint8_t>(slot);
+  return result;
+}
+
+void ObserveActivity(DriverActivity& state, bool active) {
+  if (state.active == active) {
+    return;
+  }
+  state.active = active;
+  ++state.activity_epoch;
+  if (!active) {
+    state.gating_observed = true;
+  }
+  for (uint32_t index = 0; index < kXinputSlotCount; ++index) {
+    auto& slot = state.slots[index];
+    slot.drain_pending = true;
+    slot.reconcile_pending = true;
+    if (!active) {
+      for (const auto& [key, event] : slot.delivered_keys) {
+        slot.pending_releases.push_back(
+            SyntheticKey(key, rex::input::X_INPUT_KEYSTROKE_KEYUP, index));
+      }
+      slot.delivered_keys.clear();
+    }
+  }
+}
+
+void ObserveDisconnect(DriverActivity& state, uint32_t index) {
+  auto& slot = state.slots[index];
+  if (state.output_endpoints[index]) {
+    state.output_endpoints[index]->Retire(true);
+    state.output_endpoints[index].reset();
+  }
+  slot.packet_connected = false;
+  slot.delivered_keys.clear();
+  slot.pending_releases.clear();
+  if (state.gating_observed) {
+    slot.drain_pending = true;
+    slot.reconcile_pending = true;
+  }
+}
+
+void CopyNativeKey(const XINPUT_KEYSTROKE& native, X_INPUT_KEYSTROKE& output) {
+  output.virtual_key = native.VirtualKey;
+  output.unicode = native.Unicode;
+  output.flags = native.Flags;
+  output.user_index = native.UserIndex;
+  output.hid_code = native.HidCode;
+}
+
+void RememberDeliveredKey(SlotActivity& slot, const X_INPUT_KEYSTROKE& event) {
+  const auto key = static_cast<uint16_t>(event.virtual_key);
+  const auto flags = static_cast<uint16_t>(event.flags);
+  if (flags & rex::input::X_INPUT_KEYSTROKE_KEYUP) {
+    slot.delivered_keys.erase(key);
+  } else if (flags & rex::input::X_INPUT_KEYSTROKE_KEYDOWN) {
+    slot.delivered_keys[key] = event;
+  }
+}
+
+DWORD DrainNativeKeys(decltype(&XInputGetKeystroke) query, uint32_t index,
+                      SlotActivity& slot, uint32_t& reads) {
+  while (reads < kKeystrokeReadBudget) {
+    XINPUT_KEYSTROKE discarded{};
+    ++reads;
+    const DWORD result = query(index, 0, &discarded);
+    if (result == ERROR_EMPTY) {
+      slot.drain_pending = false;
+      slot.drain_incomplete = false;
+      return ERROR_SUCCESS;
+    }
+    if (result != ERROR_SUCCESS) {
+      return result;
+    }
+  }
+  // We have not observed an empty native queue. Do not expose its unknown tail.
+  slot.drain_pending = true;
+  slot.drain_incomplete = true;
+  return ERROR_SUCCESS;
+}
