+bool NextReconciledKey(SlotActivity& slot, const XINPUT_GAMEPAD& current,
+                       uint32_t index, X_INPUT_KEYSTROKE& output) {
+  const auto physical = PhysicalHeldKeys(current, index);
+  for (const auto& [key, event] : slot.delivered_keys) {
+    if (!physical.contains(key)) {
+      output = SyntheticKey(key, rex::input::X_INPUT_KEYSTROKE_KEYUP, index);
+      slot.delivered_keys.erase(key);
+      return true;
+    }
+  }
+  for (const auto& [key, event] : physical) {
+    if (!slot.delivered_keys.contains(key)) {
+      output = event;
+      slot.delivered_keys.emplace(key, event);
+      return true;
+    }
+  }
+  slot.reconcile_pending = false;
+  return false;
